# --- General ---
ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM (Gemini) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=incident_chunks

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_password
NEO4J_DATABASE=neo4j

# --- Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# --- Chunking ---
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# --- Retrieval ---
TOP_K_VECTOR=8
TOP_K_GRAPH_HOPS=2

# --- Qdrant mode: local (embedded on disk) | server (QDRANT_HOST/PORT) | memory ---
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_data

# --- Gemini call behaviour (bounded retries; timeout enforced client-side) ---
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_TOTAL_SECONDS=90

# --- Hard token budgets for what is sent to Gemini ---
MAX_GEMINI_CONTEXT_TOKENS=6000
MAX_GEMINI_EVIDENCE_TOKENS=4000
MAX_CHAT_EVIDENCE_TOKENS=3000
TOKEN_ESTIMATE_CHARS_PER_TOKEN=3.0
